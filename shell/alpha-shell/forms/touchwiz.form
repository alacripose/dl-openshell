shploingus.form/1
form	touchwiz
	label	TouchWiz Nature UX
	rule	.WindowFrame	border-radius	8px
	# Nature UX's 8 dp corner carries to a picked live cell; radius only, never a border
	# weight that would reflow the game's own component.
	rule	.ThemedCell	border-radius	8px
	rule	.WindowFrame	border-width	2px
	rule	.WindowTitle	height	30px
	rule	.WindowTitle	padding-left	8px
	rule	.WindowTitle	padding-right	4px
	rule	.WindowTitleLabel	margin-left	26px
	rule	.WindowTitleLabel	font-size	12px
	rule	.WindowTitleLabel	letter-spacing	0.3px
	rule	.WindowButton	width	22px
	rule	.WindowButton	height	18px
	rule	.WindowButton	margin-right	5px
	rule	.WindowButton	border-radius	3px
	rule	.WindowButton Label	font-size	12px
	rule	.WindowMeta	height	16px
	rule	.WindowMeta	padding-left	8px
	rule	.WindowBody	padding	8px
	rule	.Taskbar	height	30px
	rule	.TabStrip	margin-left	96px
	rule	.PreloadStrip	margin-left	96px
	rule	.ShellTab	margin-right	3px
	rule	.ShellTab	padding	4px 10px
	rule	.ShellTab	border-radius	4px
	rule	.ShellTab	border-bottom-width	2px
	rule	.ShellTab.Active	border-bottom-width	2px
	rule	.LauncherButton	border-radius	4px
	rule	.LauncherButton	border-width	2px
	rule	.LauncherButton	padding	3px 9px
	rule	.SchemeButton	width	20px
	rule	.SchemeButton	height	20px
	rule	.SchemeButton	border-radius	4px
	rule	.ViewAction	border-radius	4px
	rule	.ViewAction	padding	6px 12px
	rule	.ContextMenu	border-radius	4px
	rule	.Toast	border-radius	4px
	rule	.Toast	border-left-width	3px
	rule	.DwellInfo	border-radius	4px
	rule	.UpdateModal	border-radius	4px
	rule	.PickerBadge	border-radius	4px
	rule	.PickerCancel	border-radius	4px
