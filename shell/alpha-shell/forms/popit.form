shploingus.form/0c51154398407e2a79127583436d2808
form	popit
	label	Popit (LBP3)
	renderer	popit
	# The LBP3 window is the rounded slab documented in gen_shell_theme.py: a normal rectangle
	# with the top and bottom edges rounded like the Nexus 5 body, not a hexagon or a tail.
	# The generic row is the fallback for a package without the Popit renderer; the renderer
	# row is the family silhouette. Both are geometry only.
	rule	.WindowFrame	border-radius	10px
	rule	.WindowFrame	border-width	2px
	rule	.WindowFrame	border-radius	18px 18px 18px 18px	popit
	rule	.WindowTitle	height	30px
	rule	.WindowTitle	padding-left	10px
	rule	.WindowTitle	padding-right	6px
	rule	.WindowTitle	border-top-left-radius	8px
	rule	.WindowTitle	border-top-right-radius	8px
	rule	.WindowTitleLabel	margin-left	24px
	rule	.WindowTitleLabel	font-size	13px
	rule	.WindowTitleLabel	letter-spacing	0.4px
	rule	.WindowButton	width	20px
	rule	.WindowButton	height	20px
	rule	.WindowButton	margin-right	4px
	rule	.WindowButton	border-radius	10px
	rule	.WindowButton	border-width	2px
	rule	.WindowButton Label	font-size	12px
	rule	.WindowMeta	height	16px
	rule	.WindowMeta	padding-left	10px
	rule	.WindowMeta	border-bottom-width	2px
	rule	.WindowBody	padding	8px
	# A themed live cell (a game drawable picked in the Picker) follows the same silhouette as
	# this form's windows. Only the radius is written: a border width would reflow the game's
	# own layout around a component it did not ask to resize.
	rule	.ThemedCell	border-radius	10px
	rule	.Taskbar	height	30px
	rule	.TabStrip	margin-left	96px
	rule	.PreloadStrip	margin-left	96px
	rule	.ShellTab	margin-right	4px
	rule	.ShellTab	padding	4px 12px
	rule	.ShellTab	border-radius	10px
	rule	.ShellTab	border-width	2px
	rule	.ShellTab.Active	border-radius	10px
	rule	.LauncherButton	border-radius	10px
	rule	.LauncherButton	border-width	2px
	rule	.LauncherButton	padding	3px 9px
	rule	.SchemeButton	width	20px
	rule	.SchemeButton	height	20px
	rule	.SchemeButton	border-radius	10px
	rule	.SchemeButton	border-width	2px
	rule	.ContextMenu	border-radius	10px
	rule	.Toast	border-left-width	4px
	rule	.DwellInfo	border-radius	10px
	rule	.UpdateModal	border-radius	10px
	# The Popit is a spine of round page tools beside a rounded tool tray. The cursor halo is the
	# selected cell's outline drawn by the shell, not a second window. Geometry only: the .theme
	# file paints every tool, item, swatch and target row from its palette roles.
	rule	.PopitSurface	width	300px
	rule	.PopitSurface	height	fit-children
	rule	.PopitCursorHalo	border-radius	12px
	# The bible asks for one LBP3 / Nexus 5 contour: crowned ends, blended corners and gently
	# bowed rails. Panorama cannot draw that custom Bezier path, so the four corners carry the
	# closest approximation the renderer supports (larger top/bottom radii than the sides). It is
	# an approximation, not the contour, and the C++/renderer work is not claimed here.
	rule	.PopitRoot	border-radius	26px 22px 26px 22px
	rule	.PopitChild	border-radius	26px 22px 26px 22px
	rule	.PopitRootRow	border-radius	14px
	rule	.PopitRootCode	font-size	9px
	rule	.PopitRootName	font-size	12px
	rule	.PopitRootHint	font-size	9px
	rule	.PopitPageDot	width	7px
	rule	.PopitPageDot	height	7px
	rule	.PopitHeader	margin-bottom	6px
	rule	.PopitHeaderTitle	font-size	12px
	rule	.PopitTargetLabel	font-size	10px
	rule	.PopitPage	min-height	160px
	rule	.PopitItem	width	84px
	rule	.PopitItem	height	66px
	rule	.PopitItem	margin	3px
	rule	.PopitItem	padding	5px
	rule	.PopitItem	border-width	2px
	rule	.PopitItem	border-radius	12px
	rule	.PopitPairSwatch	border-radius	5px
	rule	.PopitBack	border-radius	10px
	rule	.PopitBackLabel	font-size	10px
	rule	.PopitChildTitle	font-size	10px
	rule	.PopitSwatch	width	34px
	rule	.PopitSwatch	height	30px
	rule	.PopitSwatch	border-width	2px
	rule	.PopitSwatch	border-radius	8px
	rule	.PopitItemLabel	font-size	10px
	rule	.PopitTarget	padding	5px 7px
	rule	.PopitTarget	margin-bottom	4px
	rule	.PopitTarget	border-width	2px
	rule	.PopitTarget	border-radius	10px
	rule	.PopitTargetName	font-size	11px
	rule	.PopitTargetKind	font-size	9px
	rule	.PopitGroup	margin-bottom	7px
	rule	.PopitGroupLabel	font-size	9px
	rule	.PopitOption	height	26px
	rule	.PopitOption	margin-right	4px
	rule	.PopitOption	border-width	2px
	rule	.PopitOption	border-radius	8px
	rule	.PopitOptionLabel	font-size	10px
	rule	.PopitReset	height	30px
	rule	.PopitReset	border-width	2px
	rule	.PopitReset	border-radius	10px
	rule	.PopitResetLabel	font-size	10px
	rule	.PopitEmpty	font-size	10px
	rule	.PopitDetail	margin-top	7px
	rule	.PopitDetail	font-size	10px
