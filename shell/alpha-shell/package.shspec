# The performance surface is the shell measuring itself. It is a normal declared window: the
# graphs read the shell's own counters and the log is a bounded ring buffer, so opening it can
# never be the reason a frame is missed. Colours and chrome come from the active scheme/form;
# the graphs are drawn as panels, like every other shell mark.
window	performance
	title	Performance
	content	performance
	lane	control
	extent	square-pixels
	geometry	400 96 620 460
	min-size	360 260
	opacity	930
	elevation	1
	theme-role	surface
	pinnable	true
	layout	minimize,maximize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-performance
# The picker is the Popit tool that scrubs the live Panorama tree. It is a shell window, not
# a game overlay: the overlay only catches the pointer while a scrub is active, and the edits
# are applied to the selected live panel and reported by id.
window	picker
	title	Picker
	content	picker
	lane	control
	extent	square-pixels
	geometry	680 160 520 500
	min-size	380 300
	opacity	930
	elevation	1
	theme-role	surface
	pinnable	true
	layout	minimize,maximize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-picker
# The Palette editor extracts a scheme's editable slots from its .theme schema. Each swatch
# cycles that one role; the schema button shows the .theme text a player can copy to persist.
window	palette
