    { "id": "Friction", "default": 2, "surface": "ConVar sv_friction (engine default 4)" },
    { "id": "SpiritItemsBecomeStrength", "default": true, "surface": "CitadelAbilityVData.m_eItemSlotType == EItemSlotType_Tech, then CCitadelPlayerPawn.RemoveItem/AddItem" },
    { "id": "ModeName", "default": "dl-openshell", "surface": "chat + console reporting, dw_plugin enable/disable" }
  ],
  "verified": {
    "compiles": true,
    "loadedInDeadworks": true,
    "hotReload": true,
    "enableDisable": true,
    "worldConvarsReadBack": true,
    "playerInWorld": true,
    "shellPackageLoaded": true,
    "modifiersRunInGame": false
  }
