<root>
    <styles>
        <include src="file://{resources}/styles/openlock_shell.css" />
        <include src="file://{resources}/styles/openlock_schemes.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/openlock_shell_data.js" />
        <include src="file://{resources}/scripts/openlock_shell.js" />
    </scripts>

    <!-- The shell is pointer-driven on purpose. Deadlock's own control suite owns the gamepad and
         keyboard focus graph; every control here is a plain Panel with onmouseactivate, so opening
         the shell never inserts a second set of focusable controls into that graph. -->
    <Panel class="ShellRoot" hittest="false" hittestchildren="true">
        <!-- Windows the shell draws itself. -->
        <Panel id="WindowLayer" class="WindowLayer" hittest="false" hittestchildren="true" />

        <!-- Chrome for live game panels. The panels are not reparented: the frame tracks the
             panel's real rect and the panel is moved and scaled with a transform. -->
        <Panel id="PanelLayer" class="PanelLayer" hittest="false" hittestchildren="true" />

        <!-- The bar (alpha-shell D-2) sits above both layers. Panorama paints siblings in order:
             windows, then panel chrome, then the bar, then the installer strip. That order is the
             z-order strategy; nothing here depends on a z-index the older parser may reject. -->
        <Panel id="Taskbar" class="Taskbar">
            <Panel id="TabStrip" class="TabStrip" />
            <Panel class="TaskbarSpacer" />
            <Panel id="WindowsButton" class="WindowsButton" onmouseactivate="OpenlockWindows()">
                <Label class="WindowsButtonLabel" text="Windows" />
            </Panel>
            <Label id="VersionLabel" class="VersionLabel" />
            <Label id="Clock" class="Clock" text="--:--" />
        </Panel>

        <!-- The launcher is the one mark that is always on screen: it reopens the shell and it is
             never covered by a window. Pinned windows stay beside it while the shell is closed. -->
        <Panel id="LauncherBar" class="LauncherBar">
            <Panel id="LauncherButton" class="LauncherButton" onmouseactivate="OpenlockToggle()">
                <Label id="LauncherLabel" class="LauncherLabel" text="dl-openshell" />
            </Panel>
            <Panel id="SchemeButton" class="SchemeButton" onmouseactivate="OpenlockCycleScheme()">
                <Label id="SchemeLabel" class="SchemeLabel" text="D" />
            </Panel>
        </Panel>

        <Panel id="DropGrid" class="DropGrid" />

        <Panel id="ToastStack" class="ToastStack" />

        <!-- The installer's live stage. It is deliberately non-interactive: it is a readout, not
             a second control surface over the game's own top bar. -->
        <Panel id="BuildStrip" class="BuildStrip" hittest="false" hittestchildren="false">
            <Label id="BuildStage" class="BuildStage" />
            <Label id="BuildDetail" class="BuildDetail" />
        </Panel>

        <!-- The installer's control surface. It is part of the shell package, not a second UI:
             the same file is mounted by the live game and by the reduced CSDK 10 tools client.
             Grade is client state; Install asks the host to proceed through the client's own
             console command path (CitadelConCommand), so the installer sees an OPENLOCK_ACTION
             line and no synthetic input is sent to the desktop. -->
        <Panel id="InstallBar" class="InstallBar" hittest="true" hittestchildren="true">
            <Panel class="InstallHead">
                <Label class="InstallTitle" text="dl-openshell install" />
                <Label id="InstallState" class="InstallState" text="waiting" />
            </Panel>
            <Label id="InstallDetail" class="InstallDetail" text="waiting for the installer" />
            <Panel class="InstallControls">
                <Panel id="InstallGradeDev" class="InstallGrade Active"
                       onmouseactivate="OpenlockSelectGrade('dev')">
                    <Label class="InstallGradeLabel" text="Dev" />
                </Panel>
                <Panel id="InstallGradeObserver" class="InstallGrade"
                       onmouseactivate="OpenlockSelectGrade('observer')">
                    <Label class="InstallGradeLabel" text="Observer" />
                </Panel>
                <Panel id="InstallGradePlayer" class="InstallGrade"
                       onmouseactivate="OpenlockSelectGrade('player')">
                    <Label class="InstallGradeLabel" text="Player" />
                </Panel>
                <Panel class="InstallSpacer" />
                <Panel id="InstallButton" class="InstallAction"
                       onmouseactivate="OpenlockRequestInstall()">
                    <Label class="InstallActionLabel" text="Install" />
                </Panel>
            </Panel>
        </Panel>

        <Panel id="UpdateModal" class="UpdateModal">
            <Label id="UpdateTitle" class="UpdateTitle" text="Update ready" />
            <Label id="UpdateBody" class="UpdateBody" />
            <Label id="UpdateCountdown" class="UpdateCountdown" />
            <Panel class="UpdateButtons">
                <Panel class="ViewAction" onmouseactivate="OpenlockUpdateRestart()">
                    <Label text="Restart now" />
                </Panel>
                <Panel class="ViewAction" onmouseactivate="OpenlockUpdateLater()">
                    <Label text="Later" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
