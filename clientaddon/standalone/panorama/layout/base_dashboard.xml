<root>
    <!--
        The deprecated dashboard root, still loaded by the reduced CSDK 10 tools client.

        This is the stock layout, reconstructed from the game's own compiled copy: one
        <CitadelDB id="Dashboard"> that owns every dashboard window. The shell anchor is a later
        sibling, so Panorama's own paint order puts the shell above the dashboard — no z-index,
        which is what the older Panorama parser refuses to understand.

        Same mount as base_hud: openlock_boot.js loads the shell package into the anchor. A build
        that replaces this root ignores the file; a build that still loads it keeps its dashboard
        intact and gains the shell.
    -->
    <styles>
        <include src="s2r://panorama/styles/base.vcss_c" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/openlock_boot.js" />
    </scripts>
    <Panel class="WindowRoot" hittest="false" hittestchildren="true">
        <CitadelDB id="Dashboard" />
        <Panel id="OpenlockStandaloneHost" hittest="false" hittestchildren="true"
               style="width: 100%; height: 100%;" />
    </Panel>
</root>
